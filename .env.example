# ============================================================
# JARVIS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096

# ── Porcupine Wake-Word (Picovoice) ──────────────────────────
PORCUPINE_ACCESS_KEY=...
PORCUPINE_KEYWORD=jarvis
PORCUPINE_SENSITIVITY=0.7

# ── Deepgram STT ─────────────────────────────────────────────
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US

# ── ElevenLabs TTS ───────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=chaitanyakanakaminfra-lab
GITHUB_DEFAULT_BRANCH=main

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
EKS_CLUSTER_NAME=jarvis-cluster
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# ── Argo Workflows ───────────────────────────────────────────
ARGO_SERVER_URL=https://argo.your-cluster.example.com
ARGO_TOKEN=...
ARGO_NAMESPACE=argo
ARGO_WORKFLOW_TIMEOUT=3600

# ── Argo CD ──────────────────────────────────────────────────
ARGOCD_SERVER_URL=https://argocd.your-cluster.example.com
ARGOCD_TOKEN=...

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://jarvis:changeme@localhost:5432/jarvis

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION=jarvis_memory

# ── Jarvis Core ──────────────────────────────────────────────
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_VOICE_ENABLED=true
JARVIS_STT_MODE=deepgram
JARVIS_TTS_ENABLED=true
JARVIS_MEMORY_WINDOW=10
JARVIS_AGENT_TIMEOUT=120
JARVIS_MAX_RETRIES=3
JARVIS_PORT=8000
JARVIS_VOICE_PORT=8080
JARVIS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
